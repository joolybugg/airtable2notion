# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real tokens.

# Airtable personal access token (PAT).
# Create at https://airtable.com/create/tokens with scopes:
#   schema.bases:read  and  data.records:read
# and grant it access to the base you are migrating.
AIRTABLE_API_TOKEN=pat_your-airtable-token

# Airtable base id (starts with "app"). Find it at https://airtable.com/api
# or in the base URL: airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Notion internal integration secret (https://www.notion.so/my-integrations)
NOTION_API_TOKEN=ntn_your-notion-integration-secret

# Notion page the databases are created under.
# The integration must be connected to this page (page ... -> Connections).
NOTION_PARENT_PAGE_ID=your-notion-parent-page-id

# Optional: table filters (comma-separated table names).
# AIRTABLE_SKIP_TABLES=Imported table, Archive
# AIRTABLE_ONLY_TABLES=Projects, Clients
